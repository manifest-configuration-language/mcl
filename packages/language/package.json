{
  "name": "@manifest-configuration-language/language",
  "version": "0.3.12",
  "description": "MCL TextMate grammar and CodeMirror language support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/manifest-configuration-language/mcl.git",
    "directory": "packages/language"
  },
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "src",
    "reference",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./textmate": "./src/mcl.tmLanguage.json"
  },
  "scripts": {
    "build": "lezer-generator src/mcl.grammar -o src/parser.js",
    "generate:textmate": "node scripts/generate-textmate.mjs",
    "check:parity": "pnpm run build && node scripts/generate-textmate.mjs --check && node scripts/check-parity.mjs && node scripts/check-textmate.mjs && node scripts/smoke-language-support.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.11"
  },
  "devDependencies": {
    "@lezer/generator": "1.8.1",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6 <7",
    "@codemirror/language": ">=6 <7",
    "@codemirror/state": ">=6 <7",
    "@codemirror/view": ">=6 <7"
  },
  "publishConfig": {
    "access": "public"
  }
}
