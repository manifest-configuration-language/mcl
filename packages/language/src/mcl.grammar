@top MCL { Token* }

Token { Keyword | Identifier | Number | QuotedString | Comment | Operator | Punctuation | Newline }
Keyword {
  kw<"import"> | kw<"as"> | kw<"export"> | kw<"type"> | kw<"let"> | kw<"fn"> | kw<"emit"> |
  kw<"validate"> | kw<"require"> | kw<"using"> | kw<"for"> | kw<"in"> | kw<"if"> | kw<"else"> |
  kw<"each"> | kw<"descendants"> | kw<"where"> | kw<"select"> | kw<"bySchema"> | kw<"minMatches"> |
  kw<"requireEach"> | kw<"requireDescendants"> | kw<"and"> | kw<"or"> | kw<"not"> | kw<"is"> |
  kw<"true"> | kw<"false"> | kw<"null"> | kw<"output"> | kw<"Any"> | kw<"Null"> | kw<"Bool"> |
  kw<"Int"> | kw<"Decimal"> | kw<"String"> | kw<"List"> | kw<"Map"> | kw<"Function"> | kw<"Node"> | kw<"Schema">
}
kw<term> { @specialize[@name={term}]<Identifier, term> }

@tokens {
  Identifier { $[A-Za-z_] $[A-Za-z0-9_]* }
  Number { $[0-9]+ ("." $[0-9]+)? }
  QuotedString { "\"" !["\n\r]* "\"" }
  Comment { "#" ![\n\r]* }
  Operator { "==" | "!=" | "<=" | ">=" | "+" | "-" | "*" | "/" | "%" | "=" | "|" | "<" | ">" }
  Punctuation { ":" | "," | "." | "?" | "(" | ")" | "[" | "]" | "{" | "}" }
  Newline { "\r"? "\n" | "\r" }
  space { $[ \t]+ }
}

@skip { space }
