{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MCL",
  "scopeName": "source.mcl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#multiline-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.mcl",
          "match": "(?<= )#.*$|^#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mcl",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.mcl"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.mcl"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.mcl",
          "match": "\\\\."
        }
      ]
    },
    "multiline-strings": {
      "name": "string.quoted.multi.double.mcl",
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.mcl"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.mcl"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mcl",
          "match": "\\b(?:as|bySchema|descendants|each|else|emit|export|fn|for|if|import|key|let|message|minMatches|node|require|requireDescendants|requireEach|rule|schema|select|type|using|validate|where|with|without)\\b"
        },
        {
          "name": "keyword.operator.mcl",
          "match": "\\b(?:and|in|not|or)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.mcl",
          "match": "\\b(?:false|null|output|true)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.mcl",
          "match": "\\b(?:Any|Bool|Decimal|Function|Int|List|Map|Node|Null|Schema|String)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.mcl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.mcl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mcl",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mcl",
          "match": "(?:->|!=|\\?\\?|<=|==|=>|>=|-|\\*|/|%|\\+|<|=|>|\\|)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.key-value.mcl",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.mcl",
          "match": ","
        },
        {
          "name": "punctuation.accessor.mcl",
          "match": "\\.|\\?"
        }
      ]
    }
  }
}
