{
  "name": "@manifest-configuration-language/browser",
  "version": "0.0.0-development",
  "description": "Run MCL projects in a browser Web Worker using the Go WebAssembly runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/manifest-configuration-language/mcl.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "build": "tsc -p tsconfig.json",
    "generate:protocol": "node ./scripts/generate-protocol.mjs",
    "test:unit": "pnpm run build && node --test ./test/*.test.mjs",
    "prepack": "pnpm run build:wasm && pnpm run build"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "p-queue": "9.1.2"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
