{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcl.walnuts.dev/schemas/wasm-protocol-1.json",
  "title": "MCL WebAssembly request and response protocol",
  "x-mcl-limits": {
    "maxSourceBytes": 65536,
    "maxProjectFiles": 4096,
    "maxProjectFileBytes": 16777216,
    "maxProjectBytes": 67108864,
    "maxOutputBytes": 1048576,
    "maxSourceMapBytes": 1048576,
    "maxRenameNameLength": 256,
    "evaluationTimeoutMillis": 4000,
    "maxProjectPathLength": 512,
    "maxProjectPathDepth": 64
  },
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "requestId": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "operation": { "enum": ["parse", "lint", "format", "check", "evaluate", "render", "completion", "definition", "hover", "references", "rename", "renameFileImports"] },
        "position": { "$ref": "#/$defs/completionPosition" },
        "newName": { "type": "string", "maxLength": 256 },
        "oldPath": { "$ref": "#/$defs/projectPath" },
        "newPath": { "$ref": "#/$defs/projectPath" },
        "entrypoint": { "$ref": "#/$defs/projectPath", "description": "Project-relative MCL source path. Defaults to main.mcl." },
        "source": { "type": "string", "description": "UTF-8 entrypoint source, limited by the runtime." },
        "files": {
          "type": "object",
          "maxProperties": 4095,
          "description": "Project files are limited by the runtime; this count excludes the entrypoint.",
          "propertyNames": { "$ref": "#/$defs/projectPath" },
          "additionalProperties": { "$ref": "#/$defs/fileInput" }
        }
      },
      "required": ["operation", "source"],
      "allOf": [
        {
          "if": { "properties": { "operation": { "enum": ["completion", "definition", "hover", "references", "rename"] } }, "required": ["operation"] },
          "then": { "required": ["position"] }
        },
        {
          "if": { "properties": { "operation": { "const": "rename" } }, "required": ["operation"] },
          "then": { "required": ["newName"] }
        },
        {
          "if": { "properties": { "operation": { "const": "renameFileImports" } }, "required": ["operation"] },
          "then": { "required": ["oldPath", "newPath"] }
        }
      ],
      "additionalProperties": false
    },
    "projectPath": {
      "title": "ProjectPath",
      "type": "string",
      "allOf": [
        { "minLength": 1, "maxLength": 512 },
        { "not": { "pattern": "(^/|\\\\|(^|/)\\.\\.?(/|$)|//|/$|^[A-Za-z]:|\\x00)" } },
        { "pattern": "^([^/]+/){0,63}[^/]+$" }
      ]
    },
    "fileInput": {
      "type": "object",
      "description": "Binary files omit content and are supplied in the optional second run argument under the same path.",
      "properties": {
        "encoding": { "enum": ["utf8", "binary"] },
        "content": { "type": "string" }
      },
      "required": ["encoding"],
      "allOf": [
        {
          "if": { "properties": { "encoding": { "const": "utf8" } }, "required": ["encoding"] },
          "then": { "required": ["content"] }
        },
        {
          "if": { "properties": { "encoding": { "const": "binary" } }, "required": ["encoding"] },
          "then": { "not": { "required": ["content"] } }
        }
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "requestId": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ok": { "type": "boolean" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/parseResult" },
            { "$ref": "#/$defs/lintResult" },
            { "$ref": "#/$defs/formatResult" },
            { "$ref": "#/$defs/checkResult" },
            { "$ref": "#/$defs/evaluateResult" },
            { "$ref": "#/$defs/renderResult" },
            { "$ref": "#/$defs/completionResult" },
            { "$ref": "#/$defs/definitionResult" },
            { "$ref": "#/$defs/hoverResult" },
            { "$ref": "#/$defs/referencesResult" },
            { "$ref": "#/$defs/renameResult" },
            { "$ref": "#/$defs/renameFileImportsResult" }
          ]
        },
        "error": { "$ref": "#/$defs/error" }
      },
      "required": ["requestId", "ok"],
      "additionalProperties": false
    },
    "parseResult": {
      "type": "object",
      "properties": { "declarations": { "type": "integer", "minimum": 0 } },
      "required": ["declarations"],
      "additionalProperties": false
    },
    "lintResult": { "type": "array", "items": { "$ref": "#/$defs/lintDiagnostic" } },
    "lintDiagnostic": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string" },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 0 },
        "endColumn": { "type": "integer", "minimum": 0 }
      },
      "required": ["code", "message", "severity", "path", "line", "column", "endLine", "endColumn"],
      "additionalProperties": false
    },
    "formatResult": {
      "type": "object",
      "properties": { "source": { "type": "string" } },
      "required": ["source"],
      "additionalProperties": false
    },
    "checkResult": {
      "type": "object",
      "properties": { "valid": { "const": true }, "artifacts": { "type": "integer", "minimum": 0 } },
      "required": ["valid", "artifacts"],
      "additionalProperties": false
    },
    "evaluateResult": {
      "type": "object",
      "properties": { "artifacts": { "type": "integer", "minimum": 0 }, "renderedBytes": { "type": "integer", "minimum": 0 } },
      "required": ["artifacts", "renderedBytes"],
      "additionalProperties": false
    },
    "renderResult": {
      "type": "object",
      "properties": {
        "yaml": { "type": "string" },
        "artifacts": { "type": "integer", "minimum": 0 },
        "sourceMap": { "$ref": "#/$defs/sourceMap" }
      },
      "required": ["yaml", "artifacts", "sourceMap"],
      "additionalProperties": false
    },
    "sourceMap": {
      "type": "object",
      "description": "Source map entries are limited by maxSourceMapBytes. Ranges use zero-based UTF-16 line and character positions with an exclusive end.",
      "properties": {
        "complete": { "type": "boolean" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/sourceMapEntry" } }
      },
      "required": ["complete", "entries"],
      "additionalProperties": false
    },
    "sourceMapEntry": {
      "type": "object",
      "properties": {
        "document": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "description": "JSON Pointer into the rendered YAML document." },
        "kind": { "enum": ["key", "value"] },
        "output": { "$ref": "#/$defs/sourceRange" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceMapOrigin" } }
      },
      "required": ["document", "path", "kind", "output", "sources"],
      "additionalProperties": false
    },
    "sourceMapOrigin": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/projectPath" },
        "range": { "$ref": "#/$defs/sourceRange" },
        "kind": { "enum": ["mcl", "mcl-overlay-base", "mcl-overlay-patch"] },
        "multiplicity": { "enum": ["unique", "repeated", "ambiguous"] },
        "occurrences": { "type": "integer", "minimum": 1 }
      },
      "required": ["path", "range", "kind", "multiplicity", "occurrences"],
      "additionalProperties": false
    },
    "completionPosition": {
      "type": "object",
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      },
      "required": ["line", "character"],
      "additionalProperties": false
    },
    "completionItem": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "kind": { "type": "integer", "minimum": 0 },
        "insertText": { "type": "string" },
        "detail": { "type": "string" },
        "documentation": { "type": "string" }
      },
      "required": ["label", "kind"],
      "additionalProperties": false
    },
    "completionResult": {
      "type": "object",
      "properties": {
        "isIncomplete": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/completionItem" } }
      },
      "required": ["isIncomplete", "items"],
      "additionalProperties": false
    },
    "sourceRange": {
      "type": "object",
      "properties": {
        "start": { "$ref": "#/$defs/completionPosition" },
        "end": { "$ref": "#/$defs/completionPosition" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "definitionLocation": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "range": { "$ref": "#/$defs/sourceRange" }
      },
      "required": ["path", "range"],
      "additionalProperties": false
    },
    "referenceLocation": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/projectPath" },
        "range": { "$ref": "#/$defs/sourceRange" }
      },
      "required": ["path", "range"],
      "additionalProperties": false
    },
    "definitionResult": {
      "type": "object",
      "properties": {
        "location": {
          "anyOf": [
            { "$ref": "#/$defs/definitionLocation" },
            { "type": "null" }
          ]
        }
      },
      "required": ["location"],
      "additionalProperties": false
    },
    "hoverInfo": {
      "type": "object",
      "properties": {
        "contents": { "type": "string" },
        "range": { "$ref": "#/$defs/sourceRange" },
        "standardLibrary": { "$ref": "#/$defs/standardLibraryFunction" }
      },
      "required": ["contents", "range"],
      "additionalProperties": false
    },
    "standardLibraryFunction": {
      "type": "object",
      "properties": {
        "module": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["module", "name"],
      "additionalProperties": false
    },
    "hoverResult": {
      "type": "object",
      "properties": {
        "hover": {
          "anyOf": [
            { "$ref": "#/$defs/hoverInfo" },
            { "type": "null" }
          ]
        }
      },
      "required": ["hover"],
      "additionalProperties": false
    },
    "referencesResult": {
      "type": "object",
      "properties": {
        "references": { "type": "array", "items": { "$ref": "#/$defs/referenceLocation" } }
      },
      "required": ["references"],
      "additionalProperties": false
    },
    "renameEdit": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/projectPath" },
        "range": { "$ref": "#/$defs/sourceRange" },
        "newText": { "type": "string" }
      },
      "required": ["path", "range", "newText"],
      "additionalProperties": false
    },
    "renameResult": {
      "type": "object",
      "properties": {
        "edits": { "type": "array", "items": { "$ref": "#/$defs/renameEdit" } }
      },
      "required": ["edits"],
      "additionalProperties": false
    },
    "renameFileImportsResult": {
      "type": "object",
      "properties": {
        "oldPath": { "$ref": "#/$defs/projectPath" },
        "newPath": { "$ref": "#/$defs/projectPath" },
        "edits": { "type": "array", "items": { "$ref": "#/$defs/renameEdit" } }
      },
      "required": ["oldPath", "newPath", "edits"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 0 },
        "endColumn": { "type": "integer", "minimum": 0 },
        "related": {
          "type": "array",
          "items": { "$ref": "#/$defs/relatedLocation" }
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "relatedLocation": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 0 },
        "endColumn": { "type": "integer", "minimum": 0 }
      },
      "required": ["message", "path", "line", "column", "endLine", "endColumn"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ]
}
